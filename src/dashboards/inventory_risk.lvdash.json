{
  "datasets": [
    {
      "name": "ds_risk",
      "displayName": "Risk queue",
      "queryLines": [
        "SELECT risk_rank, risk_tier, risk_score, region, store_name, category, sku_name, supplier_name, on_hand_units,\n",
        "       inbound_units_in_window, ROUND(forecast_demand_window, 0) AS forecast_demand_window, lead_time_window_days,\n",
        "       projected_stockout_in_days, stockout_probability, revenue_at_risk, primary_driver, recommended_action, recommended_qty,\n",
        "       planner_explanation, CASE WHEN projected_stockout_in_days <= 3 THEN 1 ELSE 0 END AS out_within_3d, as_of_date\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.risk_recommendations\n",
        "WHERE risk_tier IN ('Critical', 'High')\n",
        "ORDER BY risk_rank\n"
      ]
    },
    {
      "name": "ds_cover",
      "displayName": "Inventory cover",
      "queryLines": [
        "SELECT region, category,\n",
        "       CASE WHEN days_of_cover < 3 THEN '1: <3 days' WHEN days_of_cover < 7 THEN '2: 3-7 days' WHEN days_of_cover < 14 THEN '3: 7-14 days'\n",
        "            WHEN days_of_cover <= 45 THEN '4: 14-45 days' ELSE '5: >45 days (excess)' END AS cover_band,\n",
        "       COUNT(*) AS store_skus\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.risk_recommendations GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_wape_overall",
      "displayName": "Forecast accuracy",
      "queryLines": [
        "SELECT MEASURE(model_wape) AS model_wape, MEASURE(baseline_wape) AS baseline_wape, MEASURE(wape_improvement_pct) / 100 AS wape_improvement,\n",
        "       MEASURE(model_bias) AS model_bias\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.mv_forecast_accuracy\n"
      ]
    },
    {
      "name": "ds_wape_category",
      "displayName": "WAPE by category",
      "queryLines": [
        "SELECT category, 'Champion model' AS forecast, MEASURE(model_wape) AS wape FROM serverless_stable_3vku19_catalog.inventory_risk.mv_forecast_accuracy GROUP BY category\n",
        "UNION ALL\n",
        "SELECT category, 'Seasonal naive (today)' AS forecast, MEASURE(baseline_wape) AS wape FROM serverless_stable_3vku19_catalog.inventory_risk.mv_forecast_accuracy GROUP BY category\n"
      ]
    },
    {
      "name": "ds_wape_promo",
      "displayName": "WAPE promo vs regular",
      "queryLines": [
        "SELECT on_promo AS day_type, 'Champion model' AS forecast, MEASURE(model_wape) AS wape FROM serverless_stable_3vku19_catalog.inventory_risk.mv_forecast_accuracy GROUP BY on_promo\n",
        "UNION ALL\n",
        "SELECT on_promo AS day_type, 'Seasonal naive (today)' AS forecast, MEASURE(baseline_wape) AS wape FROM serverless_stable_3vku19_catalog.inventory_risk.mv_forecast_accuracy GROUP BY on_promo\n"
      ]
    },
    {
      "name": "ds_stockout_trend",
      "displayName": "Stockout rate trend",
      "queryLines": [
        "SELECT sale_week, region, MEASURE(stockout_rate) AS stockout_rate\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.mv_stockout_history WHERE sale_week >= '2025-11-01' GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_alert_quality",
      "displayName": "Alert quality backtest",
      "queryLines": [
        "SELECT 'Risk radar (Critical+High)' AS method, MEASURE(radar_alerts) AS alerts, MEASURE(radar_alert_precision) AS precision, MEASURE(radar_alert_recall) AS recall\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.mv_alert_backtest\n",
        "UNION ALL\n",
        "SELECT 'Rule of thumb (cover < lead time)', MEASURE(rule_alerts), MEASURE(rule_alert_precision), MEASURE(rule_alert_recall)\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.mv_alert_backtest\n"
      ]
    },
    {
      "name": "ds_supplier",
      "displayName": "Supplier performance",
      "queryLines": [
        "SELECT supplier_name, primary_category, contract_lead_time_days, avg_actual_lead_time_days, on_time_rate_last_30d, open_lines, overdue_open_lines\n",
        "FROM serverless_stable_3vku19_catalog.inventory_risk.gold_supplier_lead_time_stats ORDER BY on_time_rate_last_30d\n"
      ]
    }
  ],
